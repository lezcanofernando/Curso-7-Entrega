# --- Claude ---
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-sonnet-5-5)
MODEL=

# --- Redis (estado de los jobs + checkpoints de LangGraph) ---
# Local:           redis://localhost:6379
# Docker Compose:  lo pisa docker-compose.yml con redis://redis:6379
REDIS_URL=redis://localhost:6379

# Cantidad de workers dentro de la API (0 = los corrés aparte con: python -m app.worker)
WORKERS=5

# --- Observabilidad: LangSmith (https://smith.langchain.com) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supermercados-del-valle-e7
